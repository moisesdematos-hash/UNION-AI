{
  "name": "@union/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run --pool=forks --maxWorkers=2 --minWorkers=1",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "admin:promote": "tsx src/scripts/promote-admin.ts",
    "worker": "tsx src/scripts/worker.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "@union/shared": "*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ipaddr.js": "^1.9.1",
    "jsonwebtoken": "^9.0.3",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.1",
    "stripe": "^23.0.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "better-sqlite3": "12.11.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
