# Desenvolvimento. Nunca copiar valores de exemplo para produção.
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:1590
APP_URL=http://localhost:1590
JWT_SECRET=union-ai-super-secret-key-change-in-production-2026
# Produção: segredo aleatório com pelo menos 32 caracteres.

# PostgreSQL/Supabase: obrigatório em produção. API keys Supabase não substituem esta ligação.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DB_SSL=require
DB_POOL_MAX=5
# DB_SSL=disable apenas para PostgreSQL local sem TLS.
# SQLite existe exclusivamente em desenvolvimento/testes, requer dependências dev.
DB_PATH=./data/union.db

# Integração de IA operacional nesta versão: apenas Groq.
# Sem chave: demonstração gratuita em desenvolvimento; erro explícito em produção.
# GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Política interna de créditos por milhão de tokens reais. Rever comercialmente.
GROQ_INPUT_CREDITS_PER_MILLION=1
GROQ_OUTPUT_CREDITS_PER_MILLION=2

# Login Google: o audience tem de coincidir com este client ID.
# GOOGLE_CLIENT_ID=
# Recuperação: envio real obrigatório em produção, sem token em logs.
# RESEND_API_KEY=
EMAIL_FROM=UNION.AI <noreply@example.com>

# Pagamentos: configurar credenciais e testar em sandbox antes de ativação comercial.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADO_PAGO_WEBHOOK_SECRET=
# MCX/PayPay não integrados; devolvem indisponibilidade, mesmo com chaves.
