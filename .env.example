# ==============================================================================
# UNION.AI — ARQUIVO DE CONFIGURAÇÃO DE AMBIENTE (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR & SEGURANÇA BÁSICA
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:1590
APP_URL=http://localhost:1590
JWT_SECRET=union-ai-super-secret-key-change-in-production-2026

# ------------------------------------------------------------------------------
# 2. SUPABASE CLOUD (POSTGRESQL 24/7)
# Obtenha em: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
SUPABASE_URL=https://seu-projeto-id.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta-aqui

# Opcional: String de conexão direta PostgreSQL (Porta 5432 ou 6543 pooler)
# DATABASE_URL=postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJETO_ID].supabase.co:5432/postgres

# Fallback Local SQLite (usado quando Supabase não estiver configurado ou em testes)
DB_PATH=./data/union.db

# ------------------------------------------------------------------------------
# 3. PROVEDORES DE INTELIGÊNCIA ARTIFICIAL (LLMs)
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_sua_chave_groq_aqui
GROQ_MODEL=openai/gpt-oss-120b

# Opcionais (se quiser habilitar OpenAI ou Anthropic no AI Router)
# OPENAI_API_KEY=sk-proj-...
# ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------------------------
# 4. RECUPERAÇÃO DE SENHA POR EMAIL (RESEND)
# Obtenha em: https://resend.com/api-keys
# ------------------------------------------------------------------------------
# RESEND_API_KEY=re_sua_chave_resend_aqui
EMAIL_FROM=UNION.AI <noreply@union.ai>

# ------------------------------------------------------------------------------
# 5. GATEWAYS DE PAGAMENTO
# ------------------------------------------------------------------------------
# Stripe (Global / Cartão Internacional)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Mercado Pago / PIX (Brasil)
# MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
# MERCADO_PAGO_WEBHOOK_SECRET=...

# Obs: Gateways de Angola (Multicaixa Express, Referência Multicaixa e PayPay AO)
# já vêm pré-configurados e integrados nativamente!
